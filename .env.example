# Cérebros comparados. Um cérebro sem chave é pulado com aviso; a rodada continua.
# Claude Sonnet 5 e Claude Haiku 4.5; também o redator do Jev + redator e o paciente simulado
ANTHROPIC_API_KEY=
# GPT principal: gpt-6-astra (docs da OpenAI, 29/09/2026)
OPENAI_API_KEY=
# Jev, API paga: console da TypeSafe
TYPESAFE_API_KEY=

# Paciente simulado e juiz (ADR-0010): um modelo claude-* vai pela ANTHROPIC_API_KEY;
# outro nome usa SIM_BASE_URL/SIM_API_KEY (endpoint compatível com a OpenAI).
# Nunca um modelo da comparação (Sonnet 5, Haiku 4.5, GPT, Jev).
SIM_MODEL=claude-opus-5
SIM_BASE_URL=
SIM_API_KEY=

# Trava de custo de uma rodada completa, em dólares (inclui paciente e juiz).
BUDGET_USD=15

# Modo ao vivo local: Chatwoot via docker-compose, canal API (ADR-0004).
CHATWOOT_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
